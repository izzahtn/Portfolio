---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.name} | Mechanical Engineer @ Cornell`,
  description = siteConfig.tagline
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="heritageDark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Script to prevent Theme FOUC -->
    <script is:inline>
      const savedTheme = localStorage.getItem('portfolio-theme') || 'heritageLight';
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-theme-bg text-theme-text font-sans selection:bg-theme-rose/20 selection:text-theme-rose">
    <Header />
    <main class="flex-1 bg-artisan-paper relative">
      <slot />
    </main>
    <Footer />
  </body>
</html>
