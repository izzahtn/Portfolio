---
import BaseLayout from '../layouts/BaseLayout.astro';
import { artItems, artCategories } from '../data/art';
---

<BaseLayout
  title="Art | Izzah Nishad"
  description="Fine art and creative crafts portfolio of Izzah Nishad: watercolor portraits, high-contrast charcoal still lifes, technical ink drawings, and custom wearable pieces."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- Header -->
    <div class="border-b border-theme-border pb-6 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <span class="text-xs font-mono uppercase tracking-widest text-theme-copper block">
          FINE ART & CREATIVE CRAFTS
        </span>
        
        <!-- Random Artwork Spotlight Button -->
        <button
          id="random-art-btn"
          type="button"
          class="px-4 py-1.5 rounded-full border border-theme-copper/40 bg-theme-copper/10 hover:bg-theme-copper hover:text-white transition-all shadow-xs flex items-center gap-2 font-figtree text-xs text-theme-copper hover:text-white font-medium cursor-pointer group active:scale-95"
          title="Spotlight a random piece with artist backstory"
        >
          <span class="text-sm group-hover:rotate-45 transition-transform inline-block">🎲</span>
          <span>Spotlight Random Piece</span>
        </button>
      </div>

      <!-- Shorter Title -->
      <h1 class="text-4xl sm:text-6xl font-normal font-lora text-theme-text tracking-tight">
        Art
      </h1>

      <!-- Describing line on top with buttons to show each type -->
      <div class="space-y-3">
        <p class="text-xs sm:text-sm text-theme-text-muted font-figtree max-w-2xl leading-relaxed">
          A curated selection of physical works spanning watercolor portraits, high-contrast charcoal still lifes, archival technical ink drawings, and custom wearable art.
        </p>

        <!-- Category Filter Pills (buttons to show each type) -->
        <div class="flex flex-wrap gap-2 pt-1 font-figtree text-xs" id="art-filters">
          {artCategories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`art-filter-btn px-3.5 py-1 rounded-full border transition-all lowercase text-xs ${
                idx === 0
                  ? 'border-theme-copper bg-theme-copper text-white font-medium shadow-xs'
                  : 'border-theme-border bg-theme-surface text-theme-text-muted hover:border-theme-copper hover:text-theme-text'
              }`}
            >
              {cat.toLowerCase()}
            </button>
          ))}
        </div>
      </div>

      <!-- Box explaining that my strongest hobby is art, with the line art of me placed ON TOP of it -->
      <div class="relative mt-16 sm:mt-20 pt-6 pb-6 px-6 sm:px-8 rounded-2xl border border-theme-border/80 bg-theme-surface shadow-xs transition-colors">
        <!-- Line art of me placed ON TOP of the box -->
        <div class="absolute -top-16 sm:-top-20 right-6 sm:right-10 md:right-16 w-28 sm:w-36 md:w-40 pointer-events-none select-none">
          <img
            src="/art/line-art-me-seated.png"
            alt="Line art of Izzah Nishad sitting on top of the box"
            class="w-full h-auto drop-shadow-sm dark:invert dark:opacity-90"
            loading="eager"
          />
        </div>

        <div class="pr-24 sm:pr-40 md:pr-44 space-y-2">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase tracking-wider bg-theme-rose/10 text-theme-rose border border-theme-rose/30 font-semibold">
              ★ My Strongest Hobby
            </span>
          </div>
          <h2 class="text-xl sm:text-2xl font-lora font-normal text-theme-text tracking-tight">
            Fine Art & Physical Craft
          </h2>
          <p class="text-xs sm:text-sm text-theme-text-muted font-figtree leading-relaxed max-w-3xl">
            Art is my strongest hobby—I am skilled in painting using watercolor and acrylic, and I am an avid enjoyer of traditional art and physical craft. Whether rendering high-contrast chiaroscuro, drafting continuous technical pen plates, or sewing custom garments, the patience, spatial awareness, and precision I hone through fine art directly inform my engineering design.
          </p>
        </div>
      </div>
    </div>

    <!-- Art Masonry Grid with Interesting Architectural Shapes -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="art-grid">
      {artItems.map((item, idx) => (
        <article
          class={`art-card relative group hover:scale-[1.02] ${idx % 2 === 0 ? 'hover:rotate-1 shape-sculptural' : 'hover:-rotate-1 shape-sculptural-alt'} border border-theme-border bg-theme-surface p-4 sm:p-5 transition-all duration-300 shadow-md cursor-pointer`}
          data-category={item.category}
          data-item={JSON.stringify(item)}
        >
          <!-- Corner diamond accent -->
          <span class="corner-diamond-tl"></span>
          <span class="corner-diamond-br"></span>

          <div class="space-y-4 flex flex-col h-full justify-between">
            <!-- Artwork Image Display -->
            <div
              class="relative w-full aspect-[4/3] rounded-xl overflow-hidden flex flex-col justify-end select-none text-white border border-theme-border/50 bg-theme-surface-elevated"
            >
              {item.imageUrl ? (
                <img
                  src={item.imageUrl}
                  alt={item.title}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              ) : (
                <div class="absolute inset-0" style={`background-color: ${item.imagePlaceholderColor};`}></div>
              )}

              <!-- Subtle bottom text gradient overlay for title legibility -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent pointer-events-none"></div>
              
              {item.award && (
                <div class="absolute top-3 left-3 z-10">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-figtree bg-theme-rose text-white uppercase font-bold tracking-wider shadow-md">
                    ★ {item.award.split('•')[0]}
                  </span>
                </div>
              )}

              <div class="relative z-10 p-4 space-y-1">
                <span class="text-[10px] uppercase font-figtree tracking-wider text-theme-copper block font-semibold drop-shadow">
                  {item.category} • {item.year}
                </span>
                <h2 class="text-xl font-bold font-cormorant leading-tight group-hover:text-theme-copper transition-colors drop-shadow">
                  {item.title}
                </h2>
              </div>
            </div>

            <!-- Description and Specs -->
            <div class="space-y-3 flex-1 flex flex-col justify-between font-figtree text-xs">
              <p class="text-xs text-theme-text-muted leading-relaxed line-clamp-3">
                {item.description}
              </p>

              <div class="flex items-center justify-between text-[11px] text-theme-copper group-hover:text-theme-rose transition-colors font-medium pt-0.5">
                <span>Click for full artwork & backstory</span>
                <span>→</span>
              </div>

              <div class="pt-2.5 border-t border-theme-border/60 space-y-1.5 text-xs">
                <div>
                  <span class="text-theme-text-faint uppercase text-[10px] block font-mono">Medium</span>
                  <span class="text-theme-text font-medium block">{item.medium}</span>
                </div>
                {item.dimensions && (
                  <div>
                    <span class="text-theme-text-faint uppercase text-[10px] block font-mono">Dimensions</span>
                    <span class="text-theme-text font-medium block">{item.dimensions}</span>
                  </div>
                )}
              </div>

              <!-- Tags in Lok Ye pill style -->
              <div class="flex flex-wrap gap-1.5 pt-2">
                {item.tags.map((t) => (
                  <span class="px-2.5 py-0.5 text-[11px] rounded-full border border-theme-border/70 bg-theme-bg text-theme-text-muted">
                    #{t.toLowerCase()}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Interactive Lightbox & Spotlight Modal -->
    <div id="art-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-4 sm:p-6">
      <div class="relative w-full max-w-3xl matting-frame shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="matting-frame-inner p-6 sm:p-8 space-y-6 bg-theme-surface">
          <!-- Top Toolbar: Random Roll + Close -->
          <div class="flex items-center justify-between gap-3 border-b border-theme-border/70 pb-3">
            <button
              id="modal-random-next"
              type="button"
              class="px-4 py-1.5 rounded-full text-xs font-figtree font-medium text-theme-copper bg-theme-copper/10 border border-theme-copper/40 hover:bg-theme-copper hover:text-white transition-all flex items-center gap-1.5 cursor-pointer active:scale-95 shadow-xs"
            >
              <span>🎲</span> <span>Show Another Random Artwork</span>
            </button>
            <button id="modal-close" class="px-3.5 py-1.5 rounded-full text-theme-text-muted hover:text-white bg-theme-bg border border-theme-border font-figtree text-xs font-medium cursor-pointer transition-colors">
              ✕ Close
            </button>
          </div>

          <div id="modal-image-container" class="w-full max-h-[60vh] rounded-xl overflow-hidden border border-theme-border flex items-center justify-center relative bg-black/40">
            <img id="modal-img-elem" src="" alt="" class="w-full h-auto max-h-[60vh] object-contain hidden" />
            <div id="modal-fallback" class="p-12 text-center text-white hidden">
              <div id="modal-preview-text" class="font-cormorant text-2xl sm:text-3xl font-bold"></div>
            </div>
          </div>

          <div class="space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-theme-border pb-3">
              <div>
                <span id="modal-category" class="text-xs font-figtree text-theme-copper uppercase tracking-wider block font-semibold"></span>
                <h2 id="modal-title" class="text-2xl sm:text-3xl font-bold font-cormorant text-theme-text"></h2>
              </div>
              <span id="modal-year" class="text-xs font-mono text-theme-text-faint"></span>
            </div>

            <!-- Artist Backstory & Fun Fact Callout Box -->
            <div id="modal-funfact-container" class="hidden p-4 rounded-xl bg-theme-copper/10 border border-theme-copper/35 text-xs font-figtree flex items-start gap-3 shadow-xs">
              <span class="text-lg select-none">💡</span>
              <div class="space-y-1">
                <span class="text-[10px] font-mono uppercase tracking-wider font-bold text-theme-copper block">Artist Backstory</span>
                <p id="modal-funfact" class="text-theme-text text-sm leading-relaxed font-figtree font-medium"></p>
              </div>
            </div>

            <div id="modal-award" class="hidden p-3 rounded-md bg-theme-rose/10 border border-theme-rose/40 text-theme-rose font-figtree text-xs font-semibold"></div>

            <p id="modal-desc" class="text-sm text-theme-text-muted leading-relaxed font-figtree"></p>

            <div class="grid grid-cols-2 gap-4 p-4 bg-theme-bg border border-theme-border font-figtree text-xs rounded-sm">
              <div>
                <span class="text-theme-text-faint uppercase text-[10px] block font-mono">Medium</span>
                <span id="modal-medium" class="text-theme-text font-medium block"></span>
              </div>
              <div>
                <span class="text-theme-text-faint uppercase text-[10px] block font-mono">Dimensions</span>
                <span id="modal-dimensions" class="text-theme-text font-medium block"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll('.art-filter-btn');
  const cards = document.querySelectorAll('.art-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('border-theme-copper', 'bg-theme-copper', 'text-white', 'font-semibold', 'shadow-sm');
        b.classList.add('border-theme-border', 'bg-theme-surface', 'text-theme-text-muted');
      });
      btn.classList.add('border-theme-copper', 'bg-theme-copper', 'text-white', 'font-semibold', 'shadow-sm');
      btn.classList.remove('border-theme-border', 'bg-theme-surface', 'text-theme-text-muted');

      const selectedCat = btn.getAttribute('data-category');
      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (selectedCat === 'All' || cardCat === selectedCat) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Lightbox Modal
  const modal = document.getElementById('art-modal');
  const modalClose = document.getElementById('modal-close');
  const modalTitle = document.getElementById('modal-title');
  const modalCat = document.getElementById('modal-category');
  const modalYear = document.getElementById('modal-year');
  const modalDesc = document.getElementById('modal-desc');
  const modalMedium = document.getElementById('modal-medium');
  const modalDimensions = document.getElementById('modal-dimensions');
  const modalAward = document.getElementById('modal-award');
  const modalImg = document.getElementById('modal-img-elem') as HTMLImageElement;
  const modalFallback = document.getElementById('modal-fallback');
  const modalPreviewText = document.getElementById('modal-preview-text');
  const modalFunFact = document.getElementById('modal-funfact');
  const modalFunFactContainer = document.getElementById('modal-funfact-container');

  // Collect all art item data
  const allArtItems: any[] = [];
  cards.forEach((card) => {
    const dataStr = card.getAttribute('data-item');
    if (dataStr) {
      try {
        allArtItems.push(JSON.parse(dataStr));
      } catch (e) {}
    }
  });

  function openModalWithData(data: any) {
    if (!modal) return;
    if (modalTitle) modalTitle.textContent = data.title;
    if (modalCat) modalCat.textContent = data.category;
    if (modalYear) modalYear.textContent = data.year;
    if (modalDesc) modalDesc.textContent = data.description;
    if (modalMedium) modalMedium.textContent = data.medium;
    if (modalDimensions) modalDimensions.textContent = data.dimensions || 'Studio Plate';

    if (modalFunFact && modalFunFactContainer) {
      if (data.funFact) {
        modalFunFact.textContent = data.funFact;
        modalFunFactContainer.classList.remove('hidden');
      } else {
        modalFunFactContainer.classList.add('hidden');
      }
    }

    if (data.imageUrl && modalImg) {
      modalImg.src = data.imageUrl;
      modalImg.alt = data.title;
      modalImg.classList.remove('hidden');
      if (modalFallback) modalFallback.classList.add('hidden');
    } else {
      if (modalImg) modalImg.classList.add('hidden');
      if (modalFallback) modalFallback.classList.remove('hidden');
      if (modalPreviewText) modalPreviewText.textContent = data.title;
    }

    if (modalAward) {
      if (data.award) {
        modalAward.textContent = `★ ${data.award}`;
        modalAward.classList.remove('hidden');
      } else {
        modalAward.classList.add('hidden');
      }
    }

    modal.classList.remove('hidden');
  }

  // Card click opens modal
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const dataStr = card.getAttribute('data-item');
      if (!dataStr) return;
      openModalWithData(JSON.parse(dataStr));
    });
  });

  // Spotlight Random Piece logic
  let lastRandomIndex = -1;
  function pickRandomArtwork() {
    if (allArtItems.length === 0) return;
    let nextIndex = Math.floor(Math.random() * allArtItems.length);
    if (allArtItems.length > 1 && nextIndex === lastRandomIndex) {
      nextIndex = (nextIndex + 1) % allArtItems.length;
    }
    lastRandomIndex = nextIndex;
    const chosen = allArtItems[nextIndex];
    openModalWithData(chosen);
  }

  const randomArtBtn = document.getElementById('random-art-btn');
  if (randomArtBtn) {
    randomArtBtn.addEventListener('click', pickRandomArtwork);
  }

  const modalRandomNext = document.getElementById('modal-random-next');
  if (modalRandomNext) {
    modalRandomNext.addEventListener('click', pickRandomArtwork);
  }

  if (modalClose && modal) {
    modalClose.addEventListener('click', () => modal.classList.add('hidden'));
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });
  }
</script>
