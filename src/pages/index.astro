---
import BaseLayout from '../layouts/BaseLayout.astro';
import CadViewer from '../components/3d/CadViewer.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';
import { artItems } from '../data/art';

// Rear control arms is project 1, brake lines is project 2
const rearControlArms = projects[0];
const brakeLines = projects[1];
---

<BaseLayout>
  <!-- HERO SECTION: Artistic Maximalist Atelier -->
  <section class="relative pt-12 pb-20 border-b border-theme-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Atelier Header Ribbon -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-theme-border text-xs font-sans">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-theme-rose animate-pulse"></span>
          <span class="font-bold tracking-widest uppercase text-theme-text text-[11px]">
            CORNELL UNIVERSITY • COLLEGE OF ENGINEERING
          </span>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="artisan-tag artisan-tag-rose">Cornell Baja Racing</span>
          <span class="artisan-tag artisan-tag-celadon">SolidWorks & Ansys FEA</span>
          <span class="artisan-tag artisan-tag-copper">Class of Spring 2029</span>
        </div>
      </div>

      <!-- Main Headline Block: User's Name as the Hero Centerpiece + Lok Ye Hanging Portrait on the Side -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pt-10 pb-6 items-start">
        <!-- Left: Editorial Typography & Bio -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-theme-celadon tracking-wider uppercase">
            <span>[DESIGN ATELIER & MECHANICAL LAB]</span>
            <span class="w-12 h-[1px] bg-theme-celadon/50"></span>
            <span>ITHACA, NY</span>
          </div>

          <!-- Expressive Name Heading in Story Script -->
          <h1 class="text-6xl sm:text-8xl lg:text-9xl font-normal font-story text-theme-text tracking-normal leading-[1.05] pb-1">
            {siteConfig.name}
          </h1>

          <p class="text-2xl sm:text-3xl font-story text-theme-rose font-normal leading-snug">
            Mechanical Engineer & Maker • Cornell University ('29)
          </p>

          <p class="text-base sm:text-lg text-theme-text-muted leading-relaxed font-figtree max-w-xl">
            Designing vehicle suspension linkages for <strong>Cornell Baja Racing</strong> (previously on the Brakes subteam), researching high-voltage pulsed power optoelectronics in applied physics, and creating award-winning fine art, woodworking, and handcrafted jewelry.
          </p>

          <!-- Action buttons with playful shapes & warm editorial styling -->
          <div class="flex flex-wrap items-center gap-3 pt-3 font-figtree text-xs">
            <a
              href="/projects"
              class="px-6 py-3 rounded-full bg-theme-rose text-white font-medium hover:bg-theme-rose-muted transition-all shadow-md hover:shadow-lg flex items-center gap-2"
            >
              <span>Explore Projects (04)</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>

            <a
              href="/cad-lab"
              class="px-6 py-3 rounded-full bg-theme-surface border border-theme-border text-theme-text hover:border-theme-celadon hover:text-theme-celadon transition-all shadow-xs"
            >
              Interactive 3D CAD Lab →
            </a>
            
            <a
              href="/art"
              class="px-6 py-3 rounded-full bg-theme-surface border border-theme-border text-theme-text hover:border-theme-copper hover:text-theme-copper transition-all shadow-xs"
            >
              Art & Play Gallery →
            </a>
          </div>

          <!-- Creative Shape Badges -->
          <div class="pt-4 flex flex-wrap gap-2 text-xs font-figtree text-theme-text-muted">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-theme-border bg-theme-surface/80">
              <span class="w-1.5 h-1.5 rounded-full bg-theme-celadon"></span>
              Suspension Kinematics
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-theme-border bg-theme-surface/80">
              <span class="w-1.5 h-1.5 rounded-full bg-theme-copper"></span>
              Pulsed Optoelectronics
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-theme-border bg-theme-surface/80">
              <span class="w-1.5 h-1.5 rounded-full bg-theme-rose"></span>
              Handcrafted Jewelry & Sculpture
            </span>
          </div>
        </div>

        <!-- Right Side: Lok Ye Inspired Hanging Headshot + Architectural Candidate Dossier -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Cute Arched Hanging Portrait Frame (from the side) -->
          <div class="relative max-w-xs mx-auto lg:ml-auto group">
            <!-- Top hanging cable accent line -->
            <div class="flex flex-col items-center mb-0">
              <div class="w-[1px] h-6 bg-theme-border-strong"></div>
              <div class="w-2.5 h-2.5 rounded-full border border-theme-border-strong bg-theme-copper/40 -mt-0.5"></div>
            </div>

            <!-- Arched Pill Frame holding real headshot -->
            <div class="lokye-portrait-frame transition-transform duration-500 ease-out group-hover:rotate-1 group-hover:scale-[1.02]">
              <div class="relative overflow-hidden rounded-b-[9999px] aspect-[3/4] bg-theme-surface-elevated border border-theme-border/60">
                <img
                  src="/images/headshot.jpeg"
                  alt="Izzah Nishad"
                  class="w-full h-full object-cover object-top"
                  loading="eager"
                />
                <!-- Subtle vignette gradient -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent pointer-events-none"></div>
              </div>

              <!-- Cute Handwritten Script Label underneath -->
              <div class="text-center pt-2.5 pb-1">
                <p class="font-story text-2xl text-theme-text font-normal leading-tight">
                  Izzah Nishad
                </p>
                <p class="font-figtree text-[11px] text-theme-text-muted lowercase tracking-wider">
                  cornell mechanical engineering '29
                </p>
              </div>
            </div>
          </div>

          <!-- Dossier Card with Asymmetric Architectural Corners and Floating Diamonds -->
          <div class="relative shape-sculptural border border-theme-border bg-theme-surface p-6 shadow-lg">
            <!-- Decorative corner diamonds -->
            <span class="corner-diamond-tl"></span>
            <span class="corner-diamond-br"></span>

            <div class="space-y-3 font-figtree text-xs">
              <div class="flex items-center justify-between border-b border-theme-border pb-2.5">
                <span class="font-cormorant font-semibold text-theme-text text-base">Engineering Dossier</span>
                <span class="px-2.5 py-0.5 rounded-full bg-theme-rose/10 text-theme-rose font-mono text-[11px] font-semibold">
                  #2029-ME
                </span>
              </div>

              <div class="space-y-2 text-xs">
                <div class="flex justify-between border-b border-theme-border/50 pb-1.5">
                  <span class="text-theme-text-muted">Cornell Subteam</span>
                  <span class="text-theme-text font-medium text-right">Suspension (Formerly Brakes)</span>
                </div>
                <div class="flex justify-between border-b border-theme-border/50 pb-1.5">
                  <span class="text-theme-text-muted">Primary CAD</span>
                  <span class="text-theme-text font-medium text-right">SolidWorks 2026, Fusion 360</span>
                </div>
                <div class="flex justify-between border-b border-theme-border/50 pb-1.5">
                  <span class="text-theme-text-muted">FEA Simulation</span>
                  <span class="text-theme-text font-medium text-right">Ansys Mechanical Structural</span>
                </div>
                <div class="flex justify-between border-b border-theme-border/50 pb-1.5">
                  <span class="text-theme-text-muted">Shop Capabilities</span>
                  <span class="text-theme-text font-medium text-right">CNC Mill, Manual Lathe & Mill</span>
                </div>
                <div class="flex justify-between border-b border-theme-border/50 pb-1.5">
                  <span class="text-theme-text-muted">Robotics Record</span>
                  <span class="text-theme-text font-medium text-right">51 Awards, VEX World Finalist</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-theme-text-muted">Creative Studio</span>
                  <span class="text-theme-copper font-medium text-right">Fine Art, Hardwood, Wire Jewelry</span>
                </div>
              </div>

              <div class="pt-2.5 border-t border-theme-border flex items-center justify-between text-[11px] text-theme-text-muted">
                <span>Internship Status:</span>
                <span class="text-theme-celadon font-medium">Available Summer 2026</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED ENGINEERING PROJECTS: PROJECT 01 (REAR CONTROL ARMS) & PROJECT 02 (BRAKE LINES + 3D) -->
  <section class="py-20 border-b border-theme-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-theme-border pb-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-theme-rose block mb-1">
            SELECTED WORKS
          </span>
          <h2 class="text-3xl sm:text-5xl font-bold font-cormorant text-theme-text tracking-tight">
            Engineering Projects
          </h2>
          <p class="text-sm text-theme-text-muted font-figtree mt-2 max-w-xl">
            A collection of mechanical systems I've designed, simulated, and built by hand—from Cornell Baja racing components to laser amplifiers and competition robots.
          </p>
        </div>
        <a
          href="/projects"
          class="inline-flex items-center gap-1.5 text-xs font-medium text-theme-rose hover:text-theme-rose-muted transition-colors font-figtree"
        >
          <span>View All 4 Projects</span>
          <span>→</span>
        </a>
      </div>

      <!-- PROJECT 01: REAR SUSPENSION CONTROL ARMS -->
      <div class="relative shape-sculptural bg-theme-surface border border-theme-border p-8 sm:p-12 shadow-xl hover:shadow-2xl transition-all duration-300">
        <!-- Decorative corner diamonds -->
        <span class="corner-diamond-tl"></span>
        <span class="corner-diamond-br"></span>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7 space-y-5">
            <div class="flex items-center gap-3">
              <span class="font-cormorant text-2xl font-bold text-theme-rose">Project 01</span>
              <span class="w-8 h-[1px] bg-theme-border-strong"></span>
              <span class="text-xs font-figtree uppercase tracking-wider text-theme-text-muted">{rearControlArms.organization}</span>
              <span class="inline-block px-2.5 py-0.5 text-[11px] rounded-full border-[0.5px] border-theme-border font-figtree text-theme-text-muted ml-auto">
                Kinematics & Linkages
              </span>
            </div>

            <h3 class="text-2xl sm:text-4xl font-bold font-cormorant text-theme-text">
              <a href={`/projects/${rearControlArms.slug}`} class="hover:text-theme-rose transition-colors">
                {rearControlArms.title}
              </a>
            </h3>

            <p class="text-sm sm:text-base text-theme-text-muted leading-relaxed font-figtree">
              {rearControlArms.summary}
            </p>

            <!-- Key highlights in geometric framed pill matrix -->
            <div class="grid grid-cols-2 gap-4 py-3 border-y border-theme-border/60 font-figtree text-xs">
              <div>
                <span class="text-[11px] text-theme-text-faint block uppercase">Structural Materials</span>
                <span class="font-medium text-theme-text">Aluminum & Steel Suspension Tubes</span>
              </div>
              <div>
                <span class="text-[11px] text-theme-text-faint block uppercase">Bearing Interface</span>
                <span class="font-medium text-theme-celadon">Spherical Bearings & Precision Spacers</span>
              </div>
              <div>
                <span class="text-[11px] text-theme-text-faint block uppercase">Shop Fabrication</span>
                <span class="font-medium text-theme-text">CNC Milling, Manual Lathe & Mill</span>
              </div>
              <div>
                <span class="text-[11px] text-theme-text-faint block uppercase">Surface Treatment</span>
                <span class="font-medium text-theme-copper">Heat-Treated & Anodized Protection</span>
              </div>
            </div>

            <div class="flex items-center gap-4 pt-2 font-figtree">
              <a
                href={`/projects/${rearControlArms.slug}`}
                class="px-5 py-2.5 rounded-full bg-theme-rose text-white text-xs font-medium hover:bg-theme-rose-muted transition-colors shadow-sm inline-flex items-center gap-2"
              >
                <span>Read Full Engineering Report</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Right: Clear Architectural Blueprint / Photo Container -->
          <div class="lg:col-span-5 relative shape-arch-top overflow-hidden border border-theme-border bg-theme-surface-elevated p-6 shadow-md">
            <div class="flex items-center justify-between mb-3 text-xs font-figtree">
              <span class="font-mono uppercase text-theme-rose font-bold text-[11px]">
                // SUSPENSION GEOMETRY
              </span>
              <span class="text-theme-text-faint text-[10px]">CORNELL BAJA SAE</span>
            </div>

            <div class="aspect-[4/3] rounded-xl border border-dashed border-theme-border bg-theme-surface p-6 flex flex-col justify-between text-center relative group">
              <div class="space-y-1">
                <span class="font-cormorant text-xl text-theme-text font-bold block">
                  Rear Control Arm Assembly
                </span>
                <p class="text-xs text-theme-text-muted font-figtree max-w-xs mx-auto">
                  Connecting rear uprights directly to the chassis roll cage and supporting the shock piston assemblies under dynamic racing articulation.
                </p>
              </div>

              <!-- Technical Specification Pill Callouts -->
              <div class="space-y-2 py-2">
                <div class="flex items-center justify-between text-[11px] font-figtree px-3 py-1.5 rounded-md bg-theme-surface-elevated border border-theme-border/60">
                  <span class="text-theme-text-muted">Chassis Attachment:</span>
                  <span class="font-medium text-theme-text">Roll Cage Hardpoints</span>
                </div>
                <div class="flex items-center justify-between text-[11px] font-figtree px-3 py-1.5 rounded-md bg-theme-surface-elevated border border-theme-border/60">
                  <span class="text-theme-text-muted">Upright Mount:</span>
                  <span class="font-medium text-theme-celadon">Spherical Bearing Joints</span>
                </div>
                <div class="flex items-center justify-between text-[11px] font-figtree px-3 py-1.5 rounded-md bg-theme-surface-elevated border border-theme-border/60">
                  <span class="text-theme-text-muted">Shock Mounting:</span>
                  <span class="font-medium text-theme-copper">Integrated Clevis Tabs</span>
                </div>
              </div>

              <div class="pt-2 border-t border-theme-border/50 text-[10px] text-theme-text-faint font-mono">
                CAD SOURCE: Y:\TG23\1 - SUSPENSION\3_LINKS\REAR_LINKS
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PROJECT 02: TG22 BRAKE LINES ASSEMBLY (WITH ALTERNATING LOK YE LAYOUT & 3D VIEWER) -->
      <div class="relative shape-sculptural-alt bg-theme-surface border border-theme-border p-8 sm:p-12 shadow-xl hover:shadow-2xl transition-all duration-300">
        <!-- Decorative corner diamonds -->
        <span class="corner-diamond-tr"></span>
        <span class="corner-diamond-bl"></span>

        <!-- Alternating grid: 3D canvas on left for desktop, text on right -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-6 lg:order-2 space-y-5">
            <div class="flex items-center gap-3">
              <span class="font-cormorant text-2xl font-bold text-theme-rose">Project 02</span>
              <span class="w-8 h-[1px] bg-theme-border-strong"></span>
              <span class="text-xs font-figtree uppercase tracking-wider text-theme-text-muted">{brakeLines.organization}</span>
              <span class="inline-block px-2.5 py-0.5 text-[11px] rounded-full border-[0.5px] border-theme-rose/50 bg-theme-rose/10 text-theme-rose font-figtree font-medium ml-auto">
                Interactive 3D Assembly
              </span>
            </div>

            <h3 class="text-2xl sm:text-4xl font-bold font-cormorant text-theme-text">
              <a href={`/projects/${brakeLines.slug}`} class="hover:text-theme-rose transition-colors">
                {brakeLines.title}
              </a>
            </h3>

            <p class="text-sm sm:text-base text-theme-text-muted leading-relaxed font-figtree">
              {brakeLines.summary}
            </p>

            <!-- Key highlights -->
            <div class="grid grid-cols-2 gap-4 py-3 border-y border-theme-border/60 font-figtree text-xs">
              <div>
                <span class="text-[11px] text-theme-text-faint block uppercase">Working Pressure</span>
                <span class="font-medium text-theme-text">1,200 PSI Nominal (DOT 4 Fluid)</span>
              </div>
              <div>
                <span class="text-[11px] text-theme-text-faint block uppercase">Hardware Plumbing</span>
                <span class="font-medium text-theme-text">3/16" Seamless 304 Stainless + Braided PTFE</span>
              </div>
              <div>
                <span class="text-[11px] text-theme-text-faint block uppercase">Circuit Architecture</span>
                <span class="font-medium text-theme-celadon">Dual Master Cylinders + 3 Calipers</span>
              </div>
              <div>
                <span class="text-[11px] text-theme-text-faint block uppercase">Safety Regulation</span>
                <span class="font-medium text-theme-copper">SAE Dynamic 4-Wheel Lockup Verified</span>
              </div>
            </div>

            <div class="flex items-center gap-4 pt-2 font-figtree">
              <a
                href={`/projects/${brakeLines.slug}`}
                class="px-5 py-2.5 rounded-full bg-theme-rose text-white text-xs font-medium hover:bg-theme-rose-muted transition-colors shadow-sm inline-flex items-center gap-2"
              >
                <span>Read Full Case Study</span>
                <span>→</span>
              </a>
              <a
                href="/cad-lab"
                class="px-5 py-2.5 rounded-full border border-theme-border text-xs font-medium text-theme-text hover:border-theme-rose hover:text-theme-rose transition-colors"
              >
                Fullscreen CAD Lab ↗
              </a>
            </div>
          </div>

          <div class="lg:col-span-6 lg:order-1">
            <!-- 3D Canvas in Sculptural Rounded Frame -->
            <div class="rounded-2xl overflow-hidden border border-theme-border shadow-xl">
              <CadViewer
                modelUrl="/models/brake-lines/TG22_Brake_Lines_Assembly.glb"
                title="SolidWorks TG22 Corner Assembly"
                height="450px"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CREATIVE ATELIER: ART, WOODWORKING & JEWELRY (Lok Ye Inspired) -->
  <section class="py-20 border-b border-theme-border bg-theme-surface/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-theme-border pb-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-theme-copper block mb-1">
            CREATIVE WORKS & PLAY
          </span>
          <h2 class="text-3xl sm:text-5xl font-bold font-editorial text-theme-text tracking-tight">
            The Art & Craft Atelier
          </h2>
          <p class="text-sm text-theme-text-muted font-sans mt-2 max-w-xl">
            Fine art drawing, precision hardwood joinery, investment jewelry casting, and tailored clothing design—celebrating the tactile dialogue of physical making.
          </p>
        </div>
        <a
          href="/art"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-theme-copper hover:text-theme-rose transition-colors font-sans"
        >
          <span>View Full Gallery ({artItems.length} Works)</span>
          <span>→</span>
        </a>
      </div>

      <!-- Curated Art Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {artItems.slice(0, 4).map((art) => (
          <a
            href="/art"
            class="matting-frame group hover:border-theme-copper transition-all duration-300 block shadow-md"
          >
            <div class="matting-frame-inner p-4 space-y-3 bg-theme-surface flex flex-col h-full justify-between">
              <div
                class="w-full aspect-[4/3] rounded-sm relative overflow-hidden flex flex-col justify-end p-4 text-white"
                style={`background-color: ${art.imagePlaceholderColor};`}
              >
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                {art.award && (
                  <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full text-[9px] font-sans font-bold bg-theme-rose text-white uppercase tracking-wider">
                    Award Winner
                  </span>
                )}
                <div class="relative z-10">
                  <span class="text-[10px] uppercase font-sans tracking-wider text-theme-copper block">
                    {art.category}
                  </span>
                  <span class="font-editorial font-bold text-sm block leading-tight">
                    {art.title}
                  </span>
                </div>
              </div>

              <div class="space-y-1 text-xs font-sans">
                <p class="text-[11px] text-theme-text-muted line-clamp-2">
                  {art.medium}
                </p>
                {art.award && (
                  <p class="text-[10px] text-theme-rose font-medium">
                    ★ {art.award}
                  </p>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
