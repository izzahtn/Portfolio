---
import BaseLayout from '../layouts/BaseLayout.astro';
import CadViewer from '../components/3d/CadViewer.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';

// Rear control arms is project 1, brake lines is project 2
const rearControlArms = projects[0];
const brakeLines = projects[1];
---

<BaseLayout>
  <!-- HERO SECTION -->
  <section class="relative pt-6 sm:pt-8 pb-10 sm:pb-12 border-b border-theme-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Main Headline Block: User's Name + Bio on Left, Hanging Headshot on Right -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Left: Editorial Typography & Bio -->
        <div class="lg:col-span-7 space-y-4 sm:space-y-5">
          <!-- Expressive Name Heading in Lora -->
          <h1 class="text-5xl sm:text-7xl lg:text-8xl font-normal font-lora text-theme-text tracking-tight leading-[1.05] pb-1">
            {siteConfig.name}
          </h1>

          <p class="text-xl sm:text-2xl font-lora italic text-theme-rose font-normal leading-snug">
            Mechanical Engineer & Maker • Cornell University ('29)
          </p>

          <p class="text-sm sm:text-base text-theme-text-muted leading-relaxed font-figtree max-w-xl">
            Designing vehicle suspension linkages for <strong>Cornell Baja Racing</strong> (previously on the Brakes subteam), researching high-voltage pulsed power optoelectronics in applied physics, and creating award-winning fine art, woodworking, and handcrafted jewelry.
          </p>

          <!-- Direct Primary Action Buttons: Straight to Projects & Resume -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="/projects"
              class="px-5 py-2.5 rounded-full bg-theme-rose text-white text-xs font-semibold hover:bg-theme-rose-muted transition-all shadow-md inline-flex items-center gap-2 group cursor-pointer"
            >
              <span>Explore Engineering Projects</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <a
              href="/resume"
              class="px-4 py-2.5 rounded-full border border-theme-border text-xs font-medium text-theme-text hover:border-theme-rose hover:text-theme-rose transition-colors"
            >
              Resume & Skills
            </a>
          </div>
        </div>

        <!-- Right Side: Authentic Polaroid Headshot + Hanging Decor Charms -->
        <div class="lg:col-span-5 flex flex-col items-center lg:items-end justify-center relative pt-2 sm:pt-4">
          
          <!-- Hanging Charms Mobile / Dangling Decor (Leaves, Stars, Gears, Wrenches) -->
          <div class="flex items-start justify-center gap-6 sm:gap-7 mb-[-6px] pointer-events-none select-none z-10 w-full max-w-[270px] px-4">
            <!-- Charm 1: Botanical Leaf (sways gently) -->
            <div class="flex flex-col items-center animate-sway">
              <span class="w-[1.5px] h-9 bg-theme-border-strong/70"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-theme-celadon -mt-0.5"></span>
              <span class="text-sm -mt-0.5" title="Plant Lover">🌿</span>
            </div>

            <!-- Charm 2: Sparkle Star (sways slow) -->
            <div class="flex flex-col items-center animate-sway-slow">
              <span class="w-[1.5px] h-12 bg-theme-border-strong/70"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-theme-copper -mt-0.5"></span>
              <span class="text-xs text-theme-copper font-serif font-bold -mt-0.5">✦</span>
            </div>

            <!-- Charm 3: Mechanical Gear (slow spin + sway) -->
            <div class="flex flex-col items-center animate-sway">
              <span class="w-[1.5px] h-8 bg-theme-border-strong/70"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-theme-rose -mt-0.5"></span>
              <svg class="w-4 h-4 text-theme-rose animate-spin-slow -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
              </svg>
            </div>

            <!-- Charm 4: Tiny Wrench / Tool charm -->
            <div class="flex flex-col items-center animate-sway-slow">
              <span class="w-[1.5px] h-11 bg-theme-border-strong/70"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-theme-celadon -mt-0.5"></span>
              <svg class="w-3.5 h-3.5 text-theme-celadon -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
              </svg>
            </div>
          </div>

          <!-- Relative Container for Polaroid and Actual Soap Bubbles -->
          <div class="relative group select-none">
            <!-- Translucent Washi Tape Strip on Top -->
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 w-20 h-6 bg-[#e3d081]/60 backdrop-blur-xs rotate-[-3deg] z-30 shadow-xs border-y border-white/30 pointer-events-none"></div>

            <!-- Stacked Polaroid Under-Card Edge (authentically visible underneath) -->
            <div
              class="absolute inset-0 bg-[#ffffff] dark:bg-[#fbfbf9] rounded-xs border border-[#e5dfd8] rotate-[3.5deg] translate-x-3 translate-y-2.5 shadow-md pointer-events-none z-0"
              aria-hidden="true"
            >
              <div class="w-full h-full p-3.5 pb-6 flex flex-col justify-between">
                <div class="w-full aspect-[4/5] bg-[#3a2d30]/10 rounded-[1px]"></div>
                <div class="h-6"></div>
              </div>
            </div>

            <!-- Authentic Iridescent Soap Bubbles -->
            <!-- Bubble 1: Main large bubble near top-right -->
            <div class="soap-bubble w-11 h-11 -top-5 -right-5 sm:-right-6 animate-bubble-float-a" title="soap bubble"></div>

            <!-- Bubble 2: Tiny satellite bubble drifting above top-right -->
            <div class="soap-bubble w-5 h-5 -top-8 right-6 animate-bubble-float-b" title="soap bubble"></div>

            <!-- Bubble 3: Medium iridescent bubble near bottom-left -->
            <div class="soap-bubble w-9 h-9 -bottom-4 -left-5 sm:-left-6 animate-bubble-float-c" title="soap bubble"></div>

            <!-- Bubble 4: Small baby bubble near bottom-left -->
            <div class="soap-bubble w-5 h-5 -bottom-7 left-4 animate-bubble-float-a" title="soap bubble"></div>

            <!-- Bubble 5: Cute floating bubble near mid-right -->
            <div class="soap-bubble w-7 h-7 bottom-12 -right-4 animate-bubble-float-b" title="soap bubble"></div>

            <!-- Main Top Polaroid Photo Frame -->
            <div class="relative bg-[#ffffff] dark:bg-[#fbfbf9] text-[#2b2426] p-3.5 pb-6 rounded-xs shadow-[0_15px_35px_-5px_rgba(0,0,0,0.22),0_6px_15px_rgba(0,0,0,0.08)] border border-[#e5dfd8] -rotate-2 group-hover:rotate-0 group-hover:scale-105 transition-all duration-300 ease-out cursor-pointer max-w-[270px] z-10">
              
              <!-- Photo Container -->
              <div class="relative aspect-[4/5] overflow-hidden bg-[#241c1e] rounded-[1px] shadow-inner border border-black/10">
                <img
                  src="/images/headshot.jpeg"
                  alt="Izzah Nishad"
                  class="w-full h-full object-cover object-top filter brightness-[1.02] contrast-[1.03]"
                  loading="eager"
                />
                <!-- Subtle photographic emulsion glare -->
                <div class="absolute inset-0 bg-gradient-to-tr from-black/20 via-transparent to-white/10 pointer-events-none"></div>
              </div>

              <!-- Polaroid Bottom Chin Label -->
              <div class="pt-3 text-center">
                <p class="font-lora font-medium text-2xl text-[#2b2426] leading-tight">
                  Izzah Nishad
                </p>
                <p class="font-figtree text-[11px] text-[#786a6e] lowercase tracking-wider mt-0.5">
                  cornell 29
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Direct Navigation Button Immediately Linking to Projects (Replaces explore down) -->
    <div class="absolute -bottom-5 sm:-bottom-6 left-1/2 -translate-x-1/2 z-20">
      <a
        href="/projects"
        class="px-5 py-2.5 rounded-full bg-[#fcaa67] hover:bg-[#ffffc7] text-[#473335] border-2 border-[#473335]/25 shadow-lg flex items-center gap-2 transition-all duration-300 hover:scale-105 group cursor-pointer font-figtree font-semibold text-xs tracking-wide"
        title="Go directly to all Engineering Projects"
      >
        <span class="font-mono text-[10px] uppercase tracking-wider font-bold">ALL PROJECTS</span>
        <span class="text-sm group-hover:translate-x-1 transition-transform duration-200">→</span>
      </a>
    </div>
  </section>

  <!-- FEATURED ENGINEERING PROJECTS: PROJECT 01 (REAR CONTROL ARMS) & PROJECT 02 (BRAKE LINES + 3D) -->
  <section id="projects" class="py-10 sm:py-14 border-b border-theme-border relative overflow-hidden">
    <!-- Subtle Wireframe Outline Background Typography -->
    <div class="absolute right-4 top-8 text-8xl sm:text-9xl font-editorial font-bold wireframe-text-faint opacity-15 select-none pointer-events-none -mr-4">
      WORKS
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">
      
      <!-- Section Header -->
      <div class="border-b border-theme-border pb-5">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <svg class="w-4 h-4 text-theme-rose animate-spin-slow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
              </svg>
              <span class="text-xs font-mono uppercase tracking-widest text-theme-rose font-semibold">
                SELECTED WORKS ✦ 2026
              </span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold font-cormorant text-theme-text tracking-tight">
              Engineering Projects
            </h2>
            <p class="text-xs sm:text-sm text-theme-text-muted font-figtree mt-1.5 max-w-xl">
              A collection of mechanical systems I've designed, simulated, and built by hand—from Cornell Baja racing components to laser amplifiers and competition robots.
            </p>
          </div>
          <a
            href="/projects"
            class="inline-flex items-center gap-1.5 text-xs font-medium text-theme-rose hover:text-theme-rose-muted transition-colors font-figtree"
          >
            <span>View All 4 Projects</span>
            <span>→</span>
          </a>
        </div>
        <!-- Running Stitch Divider Line -->
        <div class="running-stitch w-full mt-4"></div>
      </div>

      <!-- PROJECT 01: REAR SUSPENSION CONTROL ARMS -->
      <div class="relative shape-sculptural bg-theme-surface border border-theme-border p-6 sm:p-8 shadow-xl hover:shadow-2xl transition-all duration-300">
        <!-- Decorative corner diamonds -->
        <span class="corner-diamond-tl"></span>
        <span class="corner-diamond-br"></span>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
          <div class="lg:col-span-7 space-y-4">
            <div class="flex items-center gap-3">
              <span class="font-cormorant text-xl sm:text-2xl font-bold text-theme-rose">Project 01</span>
              <span class="w-8 h-[1px] bg-theme-border-strong"></span>
              <span class="text-xs font-figtree uppercase tracking-wider text-theme-text-muted">{rearControlArms.organization}</span>
              <span class="inline-block px-2.5 py-0.5 text-[11px] rounded-full border-[0.5px] border-theme-border font-figtree text-theme-text-muted ml-auto">
                Kinematics & Linkages
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-bold font-cormorant text-theme-text">
              <a href={`/projects/${rearControlArms.slug}`} class="hover:text-theme-rose transition-colors">
                {rearControlArms.title}
              </a>
            </h3>

            <p class="text-xs sm:text-sm text-theme-text-muted leading-relaxed font-figtree">
              {rearControlArms.summary}
            </p>

            <!-- Key highlights in geometric framed pill matrix -->
            <div class="grid grid-cols-2 gap-3 py-2.5 border-y border-theme-border/60 font-figtree text-xs">
              <div>
                <span class="text-[10px] text-theme-text-faint block uppercase">Structural Materials</span>
                <span class="font-medium text-theme-text">Aluminum & Steel Suspension Tubes</span>
              </div>
              <div>
                <span class="text-[10px] text-theme-text-faint block uppercase">Bearing Interface</span>
                <span class="font-medium text-theme-celadon">Spherical Bearings & Precision Spacers</span>
              </div>
              <div>
                <span class="text-[10px] text-theme-text-faint block uppercase">Shop Fabrication</span>
                <span class="font-medium text-theme-text">CNC Milling, Manual Lathe & Mill</span>
              </div>
              <div>
                <span class="text-[10px] text-theme-text-faint block uppercase">Surface Treatment</span>
                <span class="font-medium text-theme-copper">Heat-Treated & Anodized Protection</span>
              </div>
            </div>

            <div class="flex items-center gap-4 pt-1 font-figtree">
              <a
                href={`/projects/${rearControlArms.slug}`}
                class="px-5 py-2.5 rounded-full bg-theme-rose text-white text-xs font-medium hover:bg-theme-rose-muted transition-colors shadow-sm inline-flex items-center gap-2"
              >
                <span>Read Full Engineering Report</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Right: Clear Architectural Blueprint / Photo Container -->
          <div class="lg:col-span-5 relative shape-arch-top overflow-hidden border border-theme-border bg-theme-surface-elevated p-5 shadow-md">
            <div class="flex items-center justify-between mb-2.5 text-xs font-figtree">
              <span class="font-mono uppercase text-theme-rose font-bold text-[10px]">
                // SUSPENSION GEOMETRY
              </span>
              <span class="text-theme-text-faint text-[10px]">CORNELL BAJA SAE</span>
            </div>

            <div class="aspect-[4/3] rounded-xl border border-dashed border-theme-border bg-theme-surface p-5 flex flex-col justify-between text-center relative group">
              <div class="space-y-1">
                <span class="font-cormorant text-lg sm:text-xl text-theme-text font-bold block">
                  Rear Control Arm Assembly
                </span>
                <p class="text-xs text-theme-text-muted font-figtree max-w-xs mx-auto">
                  Connecting rear uprights directly to the chassis roll cage and supporting the shock piston assemblies under dynamic racing articulation.
                </p>
              </div>

              <!-- Technical Specification Pill Callouts -->
              <div class="space-y-1.5 py-1">
                <div class="flex items-center justify-between text-[11px] font-figtree px-3 py-1 rounded-md bg-theme-surface-elevated border border-theme-border/60">
                  <span class="text-theme-text-muted">Chassis Attachment:</span>
                  <span class="font-medium text-theme-text">Roll Cage Hardpoints</span>
                </div>
                <div class="flex items-center justify-between text-[11px] font-figtree px-3 py-1 rounded-md bg-theme-surface-elevated border border-theme-border/60">
                  <span class="text-theme-text-muted">Upright Mount:</span>
                  <span class="font-medium text-theme-celadon">Spherical Bearing Joints</span>
                </div>
                <div class="flex items-center justify-between text-[11px] font-figtree px-3 py-1 rounded-md bg-theme-surface-elevated border border-theme-border/60">
                  <span class="text-theme-text-muted">Shock Mounting:</span>
                  <span class="font-medium text-theme-copper">Integrated Clevis Tabs</span>
                </div>
              </div>

              <div class="pt-2 border-t border-theme-border/50 text-[10px] text-theme-text-faint font-mono">
                CAD SOURCE: Y:\TG23\1 - SUSPENSION\3_LINKS\REAR_LINKS
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PROJECT 02: TG22 BRAKE LINES ASSEMBLY (WITH ALTERNATING LOK YE LAYOUT & 3D VIEWER) -->
      <div class="relative shape-sculptural-alt bg-theme-surface border border-theme-border p-6 sm:p-8 shadow-xl hover:shadow-2xl transition-all duration-300">
        <!-- Decorative corner diamonds -->
        <span class="corner-diamond-tr"></span>
        <span class="corner-diamond-bl"></span>

        <!-- Alternating grid: 3D canvas on left for desktop, text on right -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
          <div class="lg:col-span-6 lg:order-2 space-y-4">
            <div class="flex items-center gap-3">
              <span class="font-cormorant text-xl sm:text-2xl font-bold text-theme-rose">Project 02</span>
              <span class="w-8 h-[1px] bg-theme-border-strong"></span>
              <span class="text-xs font-figtree uppercase tracking-wider text-theme-text-muted">{brakeLines.organization}</span>
              <span class="inline-block px-2.5 py-0.5 text-[11px] rounded-full border-[0.5px] border-theme-rose/50 bg-theme-rose/10 text-theme-rose font-figtree font-medium ml-auto">
                Interactive 3D Assembly
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-bold font-cormorant text-theme-text">
              <a href={`/projects/${brakeLines.slug}`} class="hover:text-theme-rose transition-colors">
                {brakeLines.title}
              </a>
            </h3>

            <p class="text-xs sm:text-sm text-theme-text-muted leading-relaxed font-figtree">
              {brakeLines.summary}
            </p>

            <!-- Key highlights -->
            <div class="grid grid-cols-2 gap-3 py-2.5 border-y border-theme-border/60 font-figtree text-xs">
              <div>
                <span class="text-[10px] text-theme-text-faint block uppercase">Line Specification</span>
                <span class="font-medium text-theme-text">Braided Metal + Protective Coating</span>
              </div>
              <div>
                <span class="text-[10px] text-theme-text-faint block uppercase">Distribution Manifolds</span>
                <span class="font-medium text-theme-celadon">CNC 6061 Aluminum X & T Blocks</span>
              </div>
              <div>
                <span class="text-[10px] text-theme-text-faint block uppercase">Sealing Interface</span>
                <span class="font-medium text-theme-text">Faced Slides + Copper Crush Washers</span>
              </div>
              <div>
                <span class="text-[10px] text-theme-text-faint block uppercase">Hydraulic Testing</span>
                <span class="font-medium text-theme-copper">Syringe Vacuum Tested • Zero Leaks</span>
              </div>
            </div>

            <div class="flex items-center gap-4 pt-1 font-figtree">
              <a
                href={`/projects/${brakeLines.slug}`}
                class="px-5 py-2.5 rounded-full bg-theme-rose text-white text-xs font-medium hover:bg-theme-rose-muted transition-colors shadow-sm inline-flex items-center gap-2"
              >
                <span>Read Full Case Study & 3D CAD</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-6 lg:order-1">
            <!-- 3D Canvas in Sculptural Rounded Frame -->
            <div class="rounded-2xl overflow-hidden border border-theme-border shadow-xl">
              <CadViewer
                modelUrl="/models/brake-lines/TG22_Brake_Lines_Assembly.glb"
                title="SolidWorks TG22 Corner Assembly"
                height="360px"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
