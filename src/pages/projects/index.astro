---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Engineering Projects | Izzah Nishad"
  description="Mechanical engineering projects across vehicle dynamics, structural FEA, pulsed power optoelectronics, and competitive robotics."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- Header with Wireframe Outline Typography & Gear/Wrench Accents -->
    <div class="relative overflow-hidden border-b border-theme-border pb-5">
      <!-- Wireframe Background Outline Text -->
      <div class="absolute right-0 -top-4 text-7xl sm:text-9xl font-editorial font-bold wireframe-text-faint opacity-15 select-none pointer-events-none">
        GEARS
      </div>

      <div class="relative z-10 space-y-2">
        <div class="flex items-center gap-2">
          <!-- Animated Spinning Gear -->
          <svg class="w-4 h-4 text-theme-rose animate-spin-slow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg>
          <span class="text-xs font-mono uppercase tracking-widest text-theme-rose font-semibold">
            ENGINEERING DOSSIER ✦ MECHANICAL LAB
          </span>
          <!-- Wrench Icon -->
          <svg class="w-3.5 h-3.5 text-theme-copper ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
          </svg>
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold font-editorial text-theme-text tracking-tight">
          Engineering Projects
        </h1>
      </div>

      <!-- Running Stitch Divider Line -->
      <div class="running-stitch w-full mt-4"></div>
    </div>

    <!-- Projects Grid -->
    <div class="space-y-6 sm:space-y-8">
      {projects.map((project) => (
        <article class="matting-frame group hover:border-theme-rose transition-all duration-300 shadow-xl">
          <div class="matting-frame-inner p-6 sm:p-7 bg-theme-surface grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- Left Info Column -->
            <div class="lg:col-span-8 space-y-4">
              <div class="flex items-center gap-3">
                <span class="font-editorial text-2xl font-bold text-theme-rose">
                  Project {project.number}
                </span>
                <span class="w-8 h-[1px] bg-theme-border-strong"></span>
                <span class="text-xs font-mono uppercase tracking-wider text-theme-text-muted">
                  {project.organization}
                </span>
                {project.has3dModel && (
                  <span class="artisan-tag artisan-tag-rose ml-auto">
                    3D Model Live
                  </span>
                )}
              </div>

              <h2 class="text-2xl sm:text-3xl font-bold font-editorial text-theme-text group-hover:text-theme-rose transition-colors">
                <a href={`/projects/${project.slug}`}>
                  {project.title}
                </a>
              </h2>

              <p class="text-sm sm:text-base text-theme-text-muted font-sans leading-relaxed">
                {project.summary}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5 pt-2">
                {project.tags.map((tag) => (
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-sans border border-theme-border bg-theme-bg text-theme-text-muted">
                    {tag}
                  </span>
                ))}
              </div>

              <div class="pt-4 flex items-center gap-4">
                <a
                  href={`/projects/${project.slug}`}
                  class="px-5 py-2.5 rounded-full bg-theme-rose text-white text-xs font-semibold hover:bg-theme-rose-muted transition-colors inline-flex items-center gap-2 shadow-sm"
                >
                  <span>Explore Project {project.number}</span>
                  <span>→</span>
                </a>
                {project.has3dModel && (
                  <a
                    href={`/projects/${project.slug}`}
                    class="px-4 py-2 rounded-full border border-theme-border text-xs font-medium text-theme-text hover:border-theme-rose hover:text-theme-rose transition-colors"
                  >
                    View Interactive 3D ↗
                  </a>
                )}
              </div>
            </div>

            <!-- Right Key Specs Card -->
            <div class="lg:col-span-4 p-5 bg-theme-bg border border-theme-border space-y-3 font-sans text-xs">
              <div class="font-editorial font-bold text-sm text-theme-text border-b border-theme-border pb-2">
                Key Parameters
              </div>
              <div class="space-y-2 text-xs">
                {project.specs.slice(0, 4).map((spec) => (
                  <div>
                    <span class="text-[10px] text-theme-text-faint uppercase block">{spec.label}</span>
                    <span class="text-theme-text font-semibold block">{spec.value}</span>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
