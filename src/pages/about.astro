---
import BaseLayout from '../layouts/BaseLayout.astro';
import PolaroidStack from '../components/common/PolaroidStack.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="About | Izzah Nishad"
  description="Personal biography, engineering philosophy, creative studio craft, and passions outside the machine shop."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- Header with Wireframe Accent -->
    <div class="relative overflow-hidden border-b border-theme-border pb-5">
      <div class="absolute right-0 -top-4 text-7xl sm:text-9xl font-editorial font-bold wireframe-text-faint opacity-15 select-none pointer-events-none">
        ABOUT
      </div>

      <div class="relative z-10 space-y-2">
        <span class="text-xs font-mono uppercase tracking-widest text-theme-rose block mb-1">
          BIOGRAPHY & CREATIVE JOURNEY ✦ CORNELL '29
        </span>
        <h1 class="text-4xl sm:text-6xl font-normal font-lora text-theme-text tracking-tight">
          About Izzah Nishad
        </h1>
        <p class="text-xs sm:text-sm text-theme-text-muted font-sans mt-2 max-w-2xl leading-relaxed">
          Mechanical engineering student at Cornell University ('29) combining automotive racing engineering with precision fine art, woodworking, and tactile craftsmanship.
        </p>
      </div>

      <div class="running-stitch w-full mt-4"></div>
    </div>

    <!-- Main Content Grid: Story on Left, Interactive Polaroid Stack on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      
      <!-- Left Column: Personal Narrative, Engineering Journey & Outside Passions -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Background & Engineering Philosophy -->
        <div class="p-6 sm:p-8 bg-theme-surface border border-theme-border shape-sculptural relative space-y-4 shadow-lg">
          <span class="corner-diamond-tl"></span>
          <span class="corner-diamond-br"></span>

          <h2 class="text-2xl sm:text-3xl font-bold font-cormorant text-theme-text">
            Making Things That Work & Things That Move
          </h2>

          <div class="space-y-3.5 text-xs sm:text-sm text-theme-text-muted leading-relaxed font-figtree">
            <p>
              I am a Mechanical Engineering student at Cornell University ('29), currently designing and packaging suspension rear control arms for <strong>Cornell Baja Racing</strong> (previously on the Brakes subteam routing rigid stainless brake lines across the chassis).
            </p>
            <p>
              My passion for mechanical systems started four years ago in competitive robotics, where I led mechanical architecture, CAD modeling, and autonomous pathing for teams that won 51 regional and international awards, culminating as a VEX Robotics World Championship Finalist in Dallas.
            </p>
            <p>
              What defines my approach is the direct bridge between computational engineering and tactile hand-making. Whether calculating Von Mises stress distributions for a chromoly suspension arm in Ansys, turning a bearing spacer on a manual lathe to ±0.0005" tolerance, or handcrafting unique wearable jewelry and wood joinery, I believe tactile understanding of physical materials makes for vastly better mechanical design.
            </p>
          </div>
        </div>

        <!-- Outside the Machine Shop (Fun Facts & Life) -->
        <div class="p-6 sm:p-8 bg-theme-surface border border-theme-border shape-sculptural-alt relative space-y-4 shadow-lg">
          <span class="corner-diamond-tr"></span>
          <span class="corner-diamond-bl"></span>

          <h2 class="text-2xl sm:text-3xl font-bold font-cormorant text-theme-text">
            Outside the Machine Shop
          </h2>

          <div class="space-y-3.5 text-xs sm:text-sm text-theme-text-muted leading-relaxed font-figtree">
            <p>
              When I'm not in the machine shop or SolidWorks CAD, I am usually working on fine art, building physical things, or exploring:
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
              <div class="p-3.5 rounded-xl bg-theme-surface-elevated border border-theme-border/60 space-y-1">
                <div class="flex items-center gap-1.5">
                  <span class="text-sm">🎨</span>
                  <span class="text-xs font-semibold text-theme-text block font-sans">Fine Art & Painting</span>
                </div>
                <span class="text-[11px] text-theme-text-muted block">Watercolor portraits, high-contrast chiaroscuro, and technical ink drawings.</span>
              </div>

              <div class="p-3.5 rounded-xl bg-theme-surface-elevated border border-theme-border/60 space-y-1">
                <div class="flex items-center gap-1.5">
                  <span class="text-sm">🧵</span>
                  <span class="text-xs font-semibold text-theme-text block font-sans">Clothing Design & Craft</span>
                </div>
                <span class="text-[11px] text-theme-text-muted block">Overall clothing design, scrap & waste fabric garment sewing, and handcrafted leather.</span>
              </div>

              <div class="p-3.5 rounded-xl bg-theme-surface-elevated border border-theme-border/60 space-y-1">
                <div class="flex items-center gap-1.5">
                  <span class="text-sm">🌍</span>
                  <span class="text-xs font-semibold text-theme-text block font-sans">Outdoors & Travel</span>
                </div>
                <span class="text-[11px] text-theme-text-muted block">Loving the outdoors, trying new activities, and a lifelong goal to explore all 7 continents.</span>
              </div>
            </div>

            <div class="pt-3 text-xs text-theme-text-faint flex flex-wrap items-center justify-between gap-2 border-t border-theme-border/60">
              <p><strong>Languages:</strong> Fluent in Malayalam • Conversational Spanish</p>
              <p><strong>Next Skills on Radar:</strong> TIG Welding • Photography</p>
            </div>
          </div>
        </div>

        <!-- Official Resume Direct Callout (Since Resume is on /resume) -->
        <div class="p-6 rounded-2xl bg-theme-surface-elevated border border-theme-border shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-5 font-figtree">
          <div class="space-y-1">
            <span class="font-cormorant text-xl font-bold text-theme-text block">
              Looking for Formal Experience & Coursework?
            </span>
            <p class="text-xs text-theme-text-muted max-w-md">
              My complete work history, Cornell course transcripts, technical machining proficiencies, and competition record are curated on the dedicated resume page.
            </p>
          </div>

          <div class="flex items-center gap-3 flex-shrink-0">
            <a
              href="/resume"
              class="px-5 py-2.5 rounded-full bg-theme-rose text-white text-xs font-medium hover:bg-theme-rose-muted transition-colors shadow-sm flex items-center gap-1.5"
            >
              <span>View Full Resume</span>
              <span>→</span>
            </a>
            <a
              href={siteConfig.resumeUrl}
              target="_blank"
              class="px-4 py-2.5 rounded-full border border-theme-border bg-theme-surface text-theme-text text-xs hover:border-theme-rose transition-colors"
            >
              PDF ↗
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Polaroid Photo Stack -->
      <div class="lg:col-span-5 flex flex-col items-center space-y-4 sticky top-24">
        <div class="text-center pb-1">
          <span class="text-[11px] font-mono uppercase tracking-widest text-theme-rose block">
            SNAPSHOTS & MEMORIES
          </span>
          <span class="text-xs text-theme-text-muted font-figtree">
            Click to flip photos
          </span>
        </div>

        <PolaroidStack />

        <div class="pt-4 text-center">
          <a
            href={`mailto:${siteConfig.email}`}
            class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-theme-border bg-theme-surface hover:border-theme-celadon hover:text-theme-celadon text-theme-text text-xs font-figtree transition-colors"
          >
            <span>Say hello via email</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
