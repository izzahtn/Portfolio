---
import { themes, defaultTheme } from '../../config/theme';
---

<div class="relative inline-block text-left theme-switcher-widget">
  <button
    id="theme-toggle-btn"
    type="button"
    class="inline-flex items-center gap-2 px-2.5 py-1 text-xs font-mono border border-theme-border bg-theme-surface hover:bg-theme-surface-hover text-theme-text transition-colors select-none"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span class="w-2 h-2 rounded-full bg-theme-rose"></span>
    <span id="current-theme-label" class="hidden sm:inline">PALETTE</span>
    <svg class="w-3 h-3 text-theme-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    id="theme-dropdown-menu"
    class="hidden absolute right-0 mt-1.5 w-64 origin-top-right border border-theme-border bg-theme-surface shadow-2xl z-50 p-1 divide-y divide-theme-border text-xs font-mono"
  >
    <div class="px-2 py-1.5 text-[10px] text-theme-text-faint uppercase tracking-wider">
      Select Color Palette
    </div>
    <div class="py-1">
      {Object.values(themes).map((t) => (
        <button
          type="button"
          data-theme-id={t.id}
          class="theme-option w-full text-left px-2.5 py-2 hover:bg-theme-surface-hover flex flex-col gap-1 transition-colors group"
        >
          <div class="flex items-center justify-between">
            <span class="font-semibold text-theme-text group-hover:text-theme-rose transition-colors">
              {t.name}
            </span>
            <div class="flex items-center gap-1">
              <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${t.colors.rose};`}></span>
              <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${t.colors.celadon};`}></span>
            </div>
          </div>
          <span class="text-[10px] text-theme-text-muted line-clamp-1">
            {t.description}
          </span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('theme-toggle-btn');
  const dropdown = document.getElementById('theme-dropdown-menu');
  const label = document.getElementById('current-theme-label');
  const options = document.querySelectorAll('.theme-option');

  // Load saved theme or default
  const savedTheme = localStorage.getItem('portfolio-theme') || 'heritageDark';
  applyTheme(savedTheme);

  if (toggleBtn && dropdown) {
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      dropdown.classList.add('hidden');
    });

    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        const themeId = opt.getAttribute('data-theme-id');
        if (themeId) {
          applyTheme(themeId);
          dropdown.classList.add('hidden');
        }
      });
    });
  }

  function applyTheme(themeId: string) {
    document.documentElement.setAttribute('data-theme', themeId);
    localStorage.setItem('portfolio-theme', themeId);
    
    // Update label
    if (label) {
      if (themeId === 'heritageDark') label.textContent = 'HERITAGE (DARK)';
      else if (themeId === 'heritageLight') label.textContent = 'HERITAGE (LIGHT)';
      else if (themeId === 'draftsmanDark') label.textContent = 'DRAFTSMAN (DARK)';
      else label.textContent = 'PALETTE';
    }
  }
</script>
