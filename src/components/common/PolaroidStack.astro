---
interface PhotoItem {
  id: string;
  src: string;
  alt: string;
}

const photos: PhotoItem[] = [
  { id: "headshot", src: "/images/headshot.jpeg", alt: "Izzah Nishad" },
  { id: "travel", src: "/images/fun-photos/travel.jpeg", alt: "Travel and exploring" },
  { id: "travel-2", src: "/images/fun-photos/travel-pt2.jpeg", alt: "Adventures abroad" },
  { id: "kayaking", src: "/images/fun-photos/Kayaking.jpeg", alt: "Kayaking outdoors" },
  { id: "halloween", src: "/images/fun-photos/halloween-walle.jpg", alt: "Handmade Wall-E" }
];
---

<div class="polaroid-widget relative select-none w-full max-w-[280px] sm:max-w-[300px] mx-auto py-2">
  <!-- Washi tape at top -->
  <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 w-20 h-6 bg-[#e3d081]/70 backdrop-blur-xs -rotate-2 z-30 shadow-xs border-y border-white/40 pointer-events-none"></div>

  <!-- Polaroid Frame Stack Container -->
  <div
    id="polaroid-deck"
    class="relative w-full cursor-pointer group"
    title="Click photo to see next"
  >
    {photos.map((photo, index) => {
      const isFirst = index === 0;
      return (
        <div
          class={`polaroid-slide ${isFirst ? 'relative' : 'absolute inset-0'} bg-[#ffffff] text-[#2b2426] p-3 pb-8 rounded-xs shadow-[0_12px_30px_-5px_rgba(0,0,0,0.22),0_4px_12px_rgba(0,0,0,0.08)] border border-[#e5dfd8] transition-all duration-300 ease-out ${
            isFirst ? 'opacity-100 scale-100 z-10 pointer-events-auto -rotate-1' : 'opacity-0 scale-95 z-0 pointer-events-none'
          }`}
          data-index={index}
        >
          <!-- Square Photo Window -->
          <div class="relative w-full aspect-square overflow-hidden bg-[#1c1819] rounded-[1px] shadow-inner border border-black/10">
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover object-center filter brightness-[1.02] contrast-[1.02]"
              loading={index === 0 ? "eager" : "lazy"}
            />
            <!-- Subtle photographic sheen -->
            <div class="absolute inset-0 bg-gradient-to-tr from-black/15 via-transparent to-white/10 pointer-events-none"></div>
          </div>
          
          <!-- Authentic blank Polaroid chin (unlabeled to avoid overlap) -->
          <div class="h-3"></div>
        </div>
      );
    })}
  </div>

  <!-- Sleek Controls Below the Polaroid -->
  <div class="flex items-center justify-between gap-2 pt-4 font-figtree text-xs text-theme-text-muted">
    <button
      id="polaroid-prev-btn"
      type="button"
      class="px-2.5 py-1 rounded-full border border-theme-border bg-theme-surface hover:border-theme-rose hover:text-theme-rose transition-colors flex items-center gap-1 cursor-pointer text-[11px]"
      title="Previous photo"
    >
      <span>←</span>
      <span>prev</span>
    </button>

    <!-- Dot Indicators -->
    <div class="flex items-center gap-1.5" id="polaroid-dots">
      {photos.map((_, i) => (
        <span
          class={`polaroid-dot inline-block rounded-full transition-all duration-300 cursor-pointer ${
            i === 0 ? 'w-4 h-1.5 bg-theme-rose' : 'w-1.5 h-1.5 bg-theme-border-strong hover:bg-theme-text-muted'
          }`}
          data-dot-index={i}
          title={`View photo ${i + 1}`}
        ></span>
      ))}
    </div>

    <button
      id="polaroid-next-btn"
      type="button"
      class="px-2.5 py-1 rounded-full border border-theme-border bg-theme-surface hover:border-theme-rose hover:text-theme-rose transition-colors flex items-center gap-1 cursor-pointer text-[11px] font-medium"
      title="Next photo"
    >
      <span>next</span>
      <span>→</span>
    </button>
  </div>
</div>

<script>
  function initPolaroidDeck() {
    const deck = document.getElementById('polaroid-deck');
    const slides = document.querySelectorAll<HTMLElement>('.polaroid-slide');
    const prevBtn = document.getElementById('polaroid-prev-btn');
    const nextBtn = document.getElementById('polaroid-next-btn');
    const dots = document.querySelectorAll<HTMLElement>('.polaroid-dot');

    if (!slides.length) return;

    let currentIndex = 0;
    const total = slides.length;
    const angles = [-1.5, 1.5, -2, 2, -1];

    function showPhoto(newIndex: number) {
      slides.forEach((slide, i) => {
        if (i === newIndex) {
          const angle = angles[i % angles.length];
          slide.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', 'z-0');
          slide.classList.add('opacity-100', 'scale-100', 'pointer-events-auto', 'z-10');
          slide.style.transform = `rotate(${angle}deg)`;
        } else {
          slide.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'z-10');
          slide.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'z-0');
          slide.style.transform = `rotate(0deg) scale(0.95)`;
        }
      });

      dots.forEach((dot, i) => {
        if (i === newIndex) {
          dot.className = 'polaroid-dot inline-block rounded-full transition-all duration-300 cursor-pointer w-4 h-1.5 bg-theme-rose';
        } else {
          dot.className = 'polaroid-dot inline-block rounded-full transition-all duration-300 cursor-pointer w-1.5 h-1.5 bg-theme-border-strong hover:bg-theme-text-muted';
        }
      });

      currentIndex = newIndex;
    }

    function next() {
      showPhoto((currentIndex + 1) % total);
    }

    function prev() {
      showPhoto((currentIndex - 1 + total) % total);
    }

    deck?.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      prev();
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        showPhoto(idx);
      });
    });
  }

  initPolaroidDeck();
  document.addEventListener('astro:page-load', initPolaroidDeck);
</script>
