---
interface PhotoItem {
  id: string;
  src: string;
  alt: string;
  imageClass?: string;
  caption?: string;
}

const photos: PhotoItem[] = [
  { id: "headshot", src: "/images/headshot.jpeg", alt: "Izzah Nishad", caption: "Izzah • Cornell '29" },
  { id: "travel", src: "/images/fun-photos/travel.jpeg", alt: "Travel and exploring", caption: "Exploring & summits" },
  {
    id: "travel-2",
    src: "/images/fun-photos/travel-pt2.jpeg",
    alt: "Suspension bridge",
    imageClass: "scale-[1.38] origin-center",
    caption: "Suspension bridge walk"
  },
  { id: "kayaking", src: "/images/fun-photos/Kayaking.jpeg", alt: "Kayaking outdoors", caption: "Outdoors on the water" },
  { id: "halloween", src: "/images/fun-photos/halloween-walle.jpg", alt: "Handmade Wall-E", caption: "Handmade Wall-E" }
];
---

<div class="polaroid-widget relative select-none w-full max-w-[280px] sm:max-w-[310px] mx-auto py-2">
  <!-- Washi tape at top -->
  <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-20 h-6 bg-[#e3d081]/75 backdrop-blur-xs -rotate-2 z-40 shadow-xs border-y border-white/40 pointer-events-none"></div>

  <!-- Delicate authentic floating soap bubbles around the stack -->
  <div class="soap-bubble w-9 h-9 -top-4 -right-4 animate-bubble-float-a" title="soap bubble"></div>
  <div class="soap-bubble w-5 h-5 -top-7 right-6 animate-bubble-float-b" title="soap bubble"></div>
  <div class="soap-bubble w-7 h-7 -bottom-3 -left-4 animate-bubble-float-c" title="soap bubble"></div>
  <div class="soap-bubble w-4 h-4 -bottom-6 left-5 animate-bubble-float-a" title="soap bubble"></div>

  <!-- Polaroid Frame Stack Container -->
  <div
    id="polaroid-deck"
    class="relative w-full cursor-pointer py-1 px-3"
    title="Click photo to flip to next"
  >
    <!-- In-flow sizer to establish exact deck dimensions -->
    <div class="invisible pointer-events-none p-3 pb-7 rounded-xs border select-none opacity-0" aria-hidden="true">
      <div class="w-full aspect-square"></div>
      <div class="h-3.5"></div>
    </div>

    <!-- Visible Layered Stack of Real Polaroid Cards -->
    {photos.map((photo, index) => {
      // Server-side initial stack classes
      const initialTransform =
        index === 0
          ? 'translate(0px, 0px) rotate(-1.5deg) scale(1)'
          : index === 1
          ? 'translate(14px, 8px) rotate(4deg) scale(0.99)'
          : index === 2
          ? 'translate(-14px, 14px) rotate(-5.5deg) scale(0.98)'
          : index === 3
          ? 'translate(4px, 20px) rotate(2deg) scale(0.96)'
          : 'translate(0px, 16px) rotate(0deg) scale(0.92)';

      const initialZIndex = index === 0 ? 30 : index === 1 ? 20 : index === 2 ? 10 : index === 3 ? 5 : 1;
      const initialOpacity = index <= 2 ? 1 : index === 3 ? 0.9 : 0;
      const initialPointerEvents = index <= 2 ? 'auto' : 'none';

      return (
        <div
          class="polaroid-slide absolute inset-0 bg-[#ffffff] dark:bg-[#fbfbf9] text-[#2b2426] p-3 pb-7 rounded-xs shadow-[0_14px_32px_-6px_rgba(0,0,0,0.24),0_4px_14px_rgba(0,0,0,0.08)] border border-[#e5dfd8] transition-all duration-350 ease-out"
          data-index={index}
          style={`transform: ${initialTransform}; z-index: ${initialZIndex}; opacity: ${initialOpacity}; pointer-events: ${initialPointerEvents};`}
        >
          <!-- Square Photo Window -->
          <div class="relative w-full aspect-square overflow-hidden bg-[#1c1819] rounded-[1px] shadow-inner border border-black/10">
            <img
              src={photo.src}
              alt={photo.alt}
              class={`w-full h-full object-cover object-center filter brightness-[1.02] contrast-[1.02] ${photo.imageClass || ''}`}
              loading={index === 0 ? "eager" : "lazy"}
            />
            <!-- Subtle photographic sheen -->
            <div class="absolute inset-0 bg-gradient-to-tr from-black/15 via-transparent to-white/10 pointer-events-none"></div>
          </div>
          
          <!-- Authentic Polaroid chin label -->
          <div class="pt-2 text-center">
            <p class="font-figtree text-[11px] text-[#786a6e] font-medium tracking-tight">
              {photo.caption}
            </p>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Sleek Controls Below the Stack -->
  <div class="flex items-center justify-between gap-2 pt-6 font-figtree text-xs text-theme-text-muted">
    <button
      id="polaroid-prev-btn"
      type="button"
      class="px-2.5 py-1 rounded-full border border-theme-border bg-theme-surface hover:border-theme-rose hover:text-theme-rose transition-colors flex items-center gap-1 cursor-pointer text-[11px]"
      title="Previous photo"
    >
      <span>←</span>
      <span>prev</span>
    </button>

    <!-- Dot Indicators -->
    <div class="flex items-center gap-1.5" id="polaroid-dots">
      {photos.map((_, i) => (
        <span
          class={`polaroid-dot inline-block rounded-full transition-all duration-300 cursor-pointer ${
            i === 0 ? 'w-4 h-1.5 bg-theme-rose' : 'w-1.5 h-1.5 bg-theme-border-strong hover:bg-theme-text-muted'
          }`}
          data-dot-index={i}
          title={`View photo ${i + 1}`}
        ></span>
      ))}
    </div>

    <button
      id="polaroid-next-btn"
      type="button"
      class="px-2.5 py-1 rounded-full border border-theme-border bg-theme-surface hover:border-theme-rose hover:text-theme-rose transition-colors flex items-center gap-1 cursor-pointer text-[11px] font-medium"
      title="Next photo"
    >
      <span>next</span>
      <span>→</span>
    </button>
  </div>
</div>

<script>
  function initPolaroidDeck() {
    const deck = document.getElementById('polaroid-deck');
    const slides = document.querySelectorAll<HTMLElement>('.polaroid-slide');
    const prevBtn = document.getElementById('polaroid-prev-btn');
    const nextBtn = document.getElementById('polaroid-next-btn');
    const dots = document.querySelectorAll<HTMLElement>('.polaroid-dot');

    if (!slides.length) return;

    let currentIndex = 0;
    const total = slides.length;
    let isAnimating = false;

    // Physical Stack Depth Configurations (Depth 0 = top, Depth 1 = peeking right, Depth 2 = peeking left, Depth 3 = peeking bottom)
    const LAYERS = [
      {
        transform: 'translate(0px, 0px) rotate(-1.5deg) scale(1)',
        zIndex: '30',
        opacity: '1',
        pointerEvents: 'auto',
      },
      {
        transform: 'translate(14px, 8px) rotate(4deg) scale(0.99)',
        zIndex: '20',
        opacity: '1',
        pointerEvents: 'auto',
      },
      {
        transform: 'translate(-14px, 14px) rotate(-5.5deg) scale(0.98)',
        zIndex: '10',
        opacity: '1',
        pointerEvents: 'auto',
      },
      {
        transform: 'translate(4px, 20px) rotate(2deg) scale(0.96)',
        zIndex: '5',
        opacity: '0.9',
        pointerEvents: 'none',
      },
      {
        transform: 'translate(0px, 16px) rotate(0deg) scale(0.92)',
        zIndex: '1',
        opacity: '0',
        pointerEvents: 'none',
      }
    ];

    function applyPositions(activeIdx: number) {
      slides.forEach((slide, i) => {
        const depth = (i - activeIdx + total) % total;
        const cfg = depth < LAYERS.length ? LAYERS[depth] : LAYERS[LAYERS.length - 1];

        slide.style.zIndex = cfg.zIndex;
        slide.style.opacity = cfg.opacity;
        slide.style.transform = cfg.transform;
        slide.style.pointerEvents = cfg.pointerEvents;
      });

      dots.forEach((dot, i) => {
        if (i === activeIdx) {
          dot.className = 'polaroid-dot inline-block rounded-full transition-all duration-300 cursor-pointer w-4 h-1.5 bg-theme-rose';
        } else {
          dot.className = 'polaroid-dot inline-block rounded-full transition-all duration-300 cursor-pointer w-1.5 h-1.5 bg-theme-border-strong hover:bg-theme-text-muted';
        }
      });
    }

    function goToPhoto(newIndex: number, peelTop = false) {
      if (isAnimating) return;
      isAnimating = true;

      const topCard = slides[currentIndex];

      if (peelTop && topCard) {
        // Peel animation: slide the top card away, then place it at the back of the stack
        topCard.style.transition = 'transform 0.32s cubic-bezier(0.2, 0.8, 0.25, 1), opacity 0.32s ease';
        topCard.style.transform = 'translate(45px, -18px) rotate(16deg) scale(0.96)';
        topCard.style.opacity = '0';

        setTimeout(() => {
          topCard.style.transition = 'all 0.35s ease-out';
          applyPositions(newIndex);
          currentIndex = newIndex;
          setTimeout(() => {
            isAnimating = false;
          }, 250);
        }, 160);
      } else {
        applyPositions(newIndex);
        currentIndex = newIndex;
        setTimeout(() => {
          isAnimating = false;
        }, 320);
      }
    }

    function next() {
      goToPhoto((currentIndex + 1) % total, true);
    }

    function prev() {
      goToPhoto((currentIndex - 1 + total) % total, false);
    }

    // Clicking top card flips to next; clicking an edge underneath jumps to that card!
    slides.forEach((slide, idx) => {
      slide.addEventListener('click', (e) => {
        e.stopPropagation();
        if (idx === currentIndex) {
          next();
        } else {
          goToPhoto(idx, false);
        }
      });
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      prev();
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        goToPhoto(idx, false);
      });
    });
  }

  initPolaroidDeck();
  document.addEventListener('astro:page-load', initPolaroidDeck);
</script>
